# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=https://rvsmps.store,https://www.rvsmps.store,https://sheglam.rvsmps.store,http://localhost:5173
LOG_LEVEL=info
PORT=5001

# Anthropic Claude API Configuration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5

# Meta WhatsApp Cloud API Integration (Optional / Pilot Roadmap)
WHATSAPP_VERIFY_TOKEN=replace_with_a_secure_random_verify_token
WHATSAPP_APP_SECRET=replace_with_meta_app_secret_for_hmac_verification
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=replace_with_meta_cloud_api_system_user_token

# Initial Database Seeding Passwords
SEED_RV_OWNER_PASSWORD=replace_with_a_strong_password
SEED_GLAM_OWNER_PASSWORD=replace_with_a_strong_password
SEED_GLAM_MANAGER_PASSWORD=replace_with_a_strong_password
